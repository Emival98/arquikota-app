{
  "name": "arquikota",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor de manutenção contínua para projetos Next.js e Vercel: dependências, APIs depreciadas, práticas e histórico de resoluções.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:ci": "tsx scripts/scan-ci.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
