# Supabase · persistência do histórico de resoluções
# Usa a URL do projeto (a raiz; /rest/v1 é normalizada pelo servidor).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role: só no servidor. Nunca a exponhas com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# EmailJS · envio de relatórios por email
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Opcional: URL pública usada nos links do email.
# Em Vercel podes omitir; o servidor usa o origin do pedido.
NEXT_PUBLIC_SITE_URL=NEXT_PUBLIC_SITE_URL=arquikota-app.vercel.app

# Opcional: aumenta o limite da API do GitHub (importação de repositórios).
GITHUB_TOKEN=
